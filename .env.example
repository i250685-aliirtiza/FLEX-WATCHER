# systemd EnvironmentFile syntax. Replace the cookie before starting.
FLEX_COOKIE="ASP.NET_SessionId=REPLACE_WITH_VALID_COOKIE"
FLEX_SEMESTER_ID=20263
FLEX_SNAPSHOT_FILE=/var/lib/flex-marks-notifier/marks-snapshot.json
FLEX_POLL_MS=300000
FLEX_REQUEST_TIMEOUT_MS=30000
FLEX_RETRY_BASE_MS=300000
FLEX_RETRY_MAX_MS=1800000
# Optional email: uncomment ALL three and supply your own values.
# FLEX_SMTP_USER=you@example.com
# FLEX_SMTP_PASS="REPLACE_WITH_APP_PASSWORD"
# FLEX_EMAIL_TO=you@example.com
# FLEX_SMTP_HOST=smtp.gmail.com
# FLEX_SMTP_PORT=465
# FLEX_EMAIL_FROM=you@example.com
# Test/debug only; leave disabled in the production service.
# FLEX_RUN_ONCE=1
# FLEX_LONG_RUN=1
# FLEX_LONG_RUN_HOURS=8
